#!/bin/bash -eu
# SPDX-FileCopyrightText: 2025 Uwe Fechner
# SPDX-License-Identifier: MIT

if [[ $(basename $(pwd)) == "bin" ]]; then
    cd ..
fi

# Ask which Julia version to use
# Default to 1.13 if it is the current default, otherwise 1.12
if juliaup status 2>/dev/null | grep '^\s*\*' | grep -q '1\.13'; then
    _default_choice=2
    _default_julia="1.13"
else
    _default_choice=1
    _default_julia="1.12"
fi

echo "Which Julia version do you want to update the manifest for?"
echo "  1) Julia 1.12"
echo "  2) Julia 1.13"
read -rp "Enter 1 or 2 [default: ${_default_choice}]: " _julia_choice

case "${_julia_choice}" in
    1)
        _desired_julia="1.12"
        ;;
    2)
        _desired_julia="1.13"
        ;;
    "")
        _desired_julia="${_default_julia}"
        ;;
    *)
        echo "Invalid choice: '${_julia_choice}'. Please enter 1 or 2."
        exit 1
        ;;
esac
echo "Using Julia version: ${_desired_julia}"

# Temporarily switch to the chosen Julia version
juliaup default "${_desired_julia}"
echo "Switched to Julia ${_desired_julia}."
echo

cd bin
./install --update -y --tests

julia_version=$(julia --version | awk '{print($3)}')
julia_major=${julia_version:0:3}
if [[ $julia_major == "1.1" ]]; then
    julia_major=${julia_version:0:4} 
fi

cd ..

# Check that all dependencies are released versions (no git branches or local paths);
# abort (set -e) without updating the default manifest if not
echo "Checking that all dependencies are released versions..."
julia --startup-file=no -e '
using TOML
manifest_file = ARGS[1]
manifest = TOML.parsefile(manifest_file)
unreleased = String[]
for (name, entries) in manifest["deps"], entry in entries
    name == "KiteControllers" && continue   # the package itself
    if haskey(entry, "repo-url")
        push!(unreleased, "$name (repo-url = $(entry["repo-url"]), repo-rev = $(get(entry, "repo-rev", "")))")
    elseif haskey(entry, "path")
        push!(unreleased, "$name (path = $(entry["path"]))")
    end
end
if isempty(unreleased)
    println("All dependencies in $manifest_file are released versions.")
else
    println("Error: the following dependencies in $manifest_file are not released versions:")
    foreach(p -> println("  - ", p), sort(unreleased))
    println("Remove the corresponding [sources] entries from the Project.toml files and try again.")
    exit(1)
end
' "Manifest-v${julia_major}.toml"

# Run the test suite; abort (set -e) without updating the default manifest if it fails
echo "Running the test suite..."
julia --project -e 'using Pkg; Pkg.test()'

cp "Manifest-v${julia_major}.toml" "Manifest-v${julia_major}.toml.default"
rm -rf ~/.julia/compiled/v${julia_major}/KiteControllers/
echo "Updated Manifest-v${julia_major}.toml.default !"
