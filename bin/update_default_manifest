#!/bin/bash -eu
# SPDX-FileCopyrightText: 2025 Uwe Fechner
# SPDX-License-Identifier: MIT

# Updates every package and writes the resolved manifest to Manifest-v<major>.toml.default,
# for each Julia version given as an argument, or else for each one that has a .default.

cd "$(dirname "$0")/.."
. ./bin/setup_env

for version in ${@:-$SUPPORTED_JULIA}; do
    JULIAUP_CHANNEL=$version ./bin/install --update -y
    # Julia 1.11 has no workspaces, so only the examples manifest holds every package.
    if [[ $version == "1.11" ]]; then
        cp examples/Manifest-v1.11.toml Manifest-v1.11.toml.default
    else
        cp "Manifest-v${version}.toml" "Manifest-v${version}.toml.default"
    fi
    echo "Updated Manifest-v${version}.toml.default"
done
