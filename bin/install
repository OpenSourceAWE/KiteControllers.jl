#!/bin/bash -eu
# SPDX-FileCopyrightText: 2025 Uwe Fechner
# SPDX-License-Identifier: MIT

yes_to_all=false
update=false
run_tests=false

print_usage() {
    echo "Usage: bin/install [-y|--yes] [--update] [--tests] [-h|--help]"
    echo
    echo "Installs the environment from Manifest-v<major>.toml.default and precompiles it."
    echo "  -y, --yes   no questions: use a supported Julia that is already installed"
    echo "  --update    Pkg.update the live manifest instead of installing the .default"
    echo "  --tests     also instantiate the test environment and run the test suite"
    echo "  -h, --help  show this help"
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help) print_usage; exit 0 ;;
        -y|--yes) yes_to_all=true ;;
        --update) update=true ;;
        --tests) run_tests=true ;;
        *)
            echo "Invalid parameter: $1"
            print_usage
            exit 1
            ;;
    esac
    shift
done

if [[ $(basename "$(pwd)") == "bin" ]]; then
    cd ..
fi

. ./bin/setup_env

# Check available disk space in home directory (require at least 5 GB)
required_kb=$((5 * 1024 * 1024))
available_kb=$(df -k "$HOME" | awk 'NR==2 {print $4}')
if (( available_kb < required_kb )); then
    echo "Error: not enough free disk space in $HOME: at least 5 GB required."
    exit 1
fi

if [[ $yes_to_all == false ]] && command -v juliaup &> /dev/null; then
    read -ra versions <<< "$SUPPORTED_JULIA"
    echo "Which Julia version do you want to use?"
    for i in "${!versions[@]}"; do
        echo "  $((i + 1))) Julia ${versions[$i]}"
    done
    read -rp "Enter a number [default: 1]: " choice
    if ! [[ ${choice:=1} =~ ^[1-9]$ && -n ${versions[$((choice - 1))]:-} ]]; then
        echo "Invalid choice: '${choice}'."
        exit 1
    fi
    desired_julia=${versions[$((choice - 1))]}
    juliaup add "$desired_julia"
    select_julia_channel "$desired_julia"
elif ! select_julia_channel $SUPPORTED_JULIA; then
    echo "Error: Julia $(active_julia) is not supported and no supported Julia is installed."
    echo "Install one of: $SUPPORTED_JULIA, e.g. 'juliaup add ${SUPPORTED_JULIA%% *}'."
    exit 1
fi
julia_version=$(julia --startup-file=no -e 'print(VERSION)')
julia_major=$(active_julia)
manifest="Manifest-v${julia_major}.toml"
echo "Using Julia $julia_version"

export JULIA_PKG_SERVER_REGISTRY_PREFERENCE=eager

rm -f "bin/kps-image-${julia_major}.so" Manifest.toml examples/Manifest.toml test/Manifest.toml

# Julia 1.11 has no workspaces: examples gets a manifest of its own, and the tracked
# .default is that one, which the root project resolves down to its own dependencies.
if [[ $julia_major == "1.11" ]]; then
    install_projects=(examples)
    install_command='using Pkg; Pkg.resolve(); Pkg.instantiate()'
else
    install_projects=()
    install_command='using Pkg; Pkg.instantiate()'
fi
for project in . "${install_projects[@]}"; do
    if [[ $update == false || ! -f $project/$manifest ]]; then
        cp "${manifest}.default" "$project/$manifest"
    fi
    if [[ $update == true ]]; then
        echo "Updating $project/$manifest..."
        julia --project="$project" -e 'using Pkg; Pkg.update()'
    else
        echo "Installing $project/$manifest from ${manifest}.default..."
        julia --project="$project" -e "$install_command"
    fi
done
echo "Precompiling..."
julia --project=examples -e 'using Pkg; Pkg.precompile()'
julia --project=examples -e 'using KiteControllers, KiteViewers, MakieControlPlots, NOMAD'

if [[ $run_tests == true ]]; then
    if [[ $julia_major == "1.11" ]]; then
        cp "$manifest" "test/$manifest"
        julia --project=test -e 'using Pkg; Pkg.resolve(); Pkg.instantiate()'
    fi
    julia --project -e 'using Pkg; Pkg.test()'
fi

if [[ ! -f .JETLSConfig.toml ]]; then
    cp .JETLSConfig.toml.default .JETLSConfig.toml
elif ! cmp -s .JETLSConfig.toml .JETLSConfig.toml.default; then
    echo "Note: .JETLSConfig.toml differs from .JETLSConfig.toml.default and was kept."
fi

mkdir -p output
echo "$julia_version" > "install_version_${julia_major}.txt"

echo
printf "\033[1;32mInstallation complete!\033[0m\n"
echo "Start Julia with 'bin/run_julia' and type 'menu()' for the examples."
