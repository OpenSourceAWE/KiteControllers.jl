#!/bin/bash
# SPDX-FileCopyrightText: 2025 Uwe Fechner
# SPDX-License-Identifier: MIT

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if [[ $(basename $(pwd)) == "bin" ]]; then
    cd ..
fi

LOG_FILE="output/jetls_$(date +%Y%m%d_%H%M%S).log"
# with more than one thread, JETLS may load GLMakie on another thread than thread 1,
# and GLFW then fails (https://github.com/aviatesk/JETLS.jl/issues/559)
jetls --threads=1,0 -- check . 2>&1 | tee "$LOG_FILE"
