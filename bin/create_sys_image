#!/bin/bash -eu

julia_version=""
_yes_to_all=false

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --version)
            if [[ $# -lt 2 ]]; then
                echo "Error: --version requires a version argument"
                exit 1
            fi
            julia_version="$2"
            shift 2
            ;;
        -y|--yes)
            _yes_to_all=true
            shift
            ;;
        *)
            echo "Invalid parameter! Use:"
            echo "./create_sys_image"
            echo "or"
            echo "./create_sys_image --version 1.x"
            echo "or"
            echo "./create_sys_image -y"
            echo "or"
            echo "./create_sys_image --yes"
            exit 1
            ;;
    esac
done

if [[ -n "$julia_version" ]]; then
    JULIA_CMD="julia +$julia_version"
else
    JULIA_CMD="julia"
fi

if [[ $(basename $(pwd)) == "bin" ]]; then
    cd ..
fi

# Check the memory and choose the number of image threads; the rules are documented in
# docs/sysimage.md. This runs before anything else, so that a machine with too little memory
# fails right away.

# Stop if RAM + swap is not enough even for one image thread (measured peak about 26 GB, plus
# a few GB of margin). Only on Linux, where both are fixed; on Windows the pagefile and on
# macOS the swap can grow, which test/create_sys_image.jl takes into account.
if [[ "$OSTYPE" == linux* ]]; then
    _total_mb=$(awk '/^(MemTotal|SwapTotal):/ {s += $2} END {printf "%i", s / 1024}' /proc/meminfo)
    if [[ $_total_mb -lt 30720 ]]; then
        echo "Error: At least 30 GB of RAM + swap is needed to create a system image, but only $(( _total_mb / 1024 )) GB is available." >&2
        echo "Increase your swap file and retry." >&2
        exit 1
    fi
fi

# Physical memory in MB
totalmem=""
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
    echo "Checking system memory on Windows..."
    totalmem=$(powershell.exe -Command "(Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory / 1MB" 2>/dev/null | awk '{printf "%i", $1}')
    limit_27gb=27000
    min_ram_mb=15000 min_ram_gb=15
elif [[ "$OSTYPE" == darwin* ]]; then
    echo "Checking system memory on macOS..."
    totalmem=$(sysctl -n hw.memsize 2>/dev/null | awk '{printf "%i", $1 / 1000000}')
    limit_27gb=27000
    min_ram_mb=7000 min_ram_gb=7
else
    totalmem=$(grep MemTotal /proc/meminfo | awk '{printf "%i", $2 / 1024}')
    limit_27gb=26674
    min_ram_mb=15000 min_ram_gb=15
fi

# 15000 MB, because a 16 GB machine reports a little less than 16 GB; on macOS 7000 MB, so
# that Macs with 8 GB of RAM can build the image, swapping to the free disk space
if [[ -z "$totalmem" ]]; then
    echo "Warning: Could not determine the size of the RAM."
elif [[ $totalmem -lt $min_ram_mb ]]; then
    echo "Error: At least $min_ram_gb GB of RAM is needed to create a system image, but only $(( totalmem / 1024 )) GB is available." >&2
    exit 1
fi

# The build needs about 26 GB with one image thread and about 30 GB with two or more, so
# with less than 27 GB of RAM two threads are used (one with fewer than 4 CPU threads).
# test/create_sys_image.jl chooses the number of threads in all other cases; it uses one
# thread if RAM + swap is less than 34 GB, also if two were chosen here.
if [[ -n "${JULIA_IMAGE_THREADS:-}" ]]; then
    echo "JULIA_IMAGE_THREADS already set to $JULIA_IMAGE_THREADS, leaving as is"
elif [[ -z "$totalmem" ]]; then
    export JULIA_IMAGE_THREADS=1 SYSIMAGE_THREADS_AUTO=true
    echo "Using only one thread for sysimage compilation."
elif [[ $totalmem -lt $limit_27gb ]]; then
    _cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo "${NUMBER_OF_PROCESSORS:-2}")
    if [[ $_cpus -ge 4 ]]; then
        export JULIA_IMAGE_THREADS=2
    else
        export JULIA_IMAGE_THREADS=1
    fi
    export SYSIMAGE_THREADS_AUTO=true
    echo "Less than 27GB of memory detected. Using $JULIA_IMAGE_THREADS thread(s) for sysimage compilation."
fi

mkdir -p output

export MPLBACKEND=agg
export JULIA_PKG_SERVER_REGISTRY_PREFERENCE="eager"

if ! command -v juliaup &> /dev/null; then
    echo "Juliaup not found. Please run: ./install"
    exit 1
fi

if ! command -v julia &> /dev/null; then
    echo "Julia not found. Please run: ./install"
    exit 1
fi

julia_version=$($JULIA_CMD --version | awk '{print($3)}')
julia_major=${julia_version:0:3}
if [[ $julia_major == "1.1" ]]; then
    julia_major=${julia_version:0:4} 
fi

# if the current julia version is not supported, install Julia 1.12
if [[ $julia_major == "1.12" ]] || [[ $julia_major == "1.13" ]]; then
    echo "Supported Julia version found!"
else
    echo "The current Julia version is not supported, installing Julia 1.12!"
    juliaup add 1.12
    juliaup default 1.12
fi

# create a logfile for the sysimage creation process
./bin/batch_pilot hydra20_600

$JULIA_CMD --startup-file=no --project -e "using Pkg; Pkg.instantiate();"
$JULIA_CMD --startup-file=no --project=test -e "include(\"./test/create_sys_image.jl\")"

SOFILE="bin/kps-image-${julia_major}.so"
if test -f $SOFILE; then
    mv $SOFILE $SOFILE.bak
fi
mv kps-image_tmp.so $SOFILE
$JULIA_CMD --startup-file=no  --project -e "using Pkg; Pkg.precompile(); Pkg.resolve()"
$JULIA_CMD --project -J bin/kps-image-${julia_major}.so -e "using KiteUtils, KiteControllers"
$JULIA_CMD --project=test -J bin/kps-image-${julia_major}.so -e "using MakieControlPlots, NativeFileDialog"
$JULIA_CMD --project -J bin/kps-image-${julia_major}.so -e "using Pkg; Pkg.instantiate()"
$JULIA_CMD --project=examples -J bin/kps-image-${julia_major}.so -e "using NOMAD, KiteViewers, Pkg; Pkg.instantiate(); Pkg.precompile()"

# Precompile Revise, if installed, with the sys image so run_julia doesn't recompile it
$JULIA_CMD --startup-file=no --project -J bin/kps-image-${julia_major}.so -e '
if Base.identify_package("Revise") !== nothing
    println("Precompiling Revise with sysimage...")
    using Revise
end'

# KaimonGate, if installed, loads Profile in interactive sessions, which is not part of the
# sys image; precompile it with the sys image so run_julia doesn't recompile it
$JULIA_CMD --startup-file=no --project -J bin/kps-image-${julia_major}.so -e '
if Base.identify_package("KaimonGate") !== nothing
    println("Precompiling Profile with sysimage...")
    Base.require(Base.PkgId(Base.UUID("9abbd945-dff8-562f-b5e8-e1ebf5ef1b79"), "Profile"))
end'

# On Linux, suppress known-harmless Julia extension loading warnings (e.g. DistributionsTestExt).
# The error spans multiple lines (┌ Error: ... │ ... └ @ Base), so use sed range deletion.
if [[ "$(uname -s)" == "Linux" ]]; then
    exec 2> >(sed '/Error during loading of extension FilePathsURIsExt of FilePaths/,/^└/d' >&2)
fi
$JULIA_CMD --project=docs -J bin/kps-image-${julia_major}.so -e "using LiveServer, Documenter, Pkg; Pkg.instantiate()"